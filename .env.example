# Canonical site URL (used for OG images, sitemap, JSON-LD). Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=https://janithjayashan.dev

# GitHub username for the live proof strip
GITHUB_USERNAME=janithjay
# Optional: raises the GitHub API rate limit at build/revalidate time (read-only, no scopes needed)
GITHUB_TOKEN=

# "Ask about me" assistant (off unless ASK_ENABLED=true and a key is set).
# Any endpoint that speaks the standard /v1/chat/completions format works.
ASK_ENABLED=false
ASK_API_URL=
ASK_API_KEY=
ASK_MODEL=
